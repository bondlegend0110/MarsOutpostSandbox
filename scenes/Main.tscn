[sub_resource type="GDScript" id="GDScript_05li3"]
script/source = "extends Node

@onready var http_request := HTTPRequest.new()

# Reference to the middle_level node. 
# Adjust this path to match your actual scene structure under \"Main\".
@onready var middle_level_script := $'Profile View/Middle Level'

var time_accum: float = 0.0
const POLL_INTERVAL = 3.0

func _ready() -> void:
	add_child(http_request)
	http_request.request_completed.connect(_on_request_completed)

func _process(delta: float) -> void:
	time_accum += delta
	if time_accum >= POLL_INTERVAL:
		time_accum = 0.0
		var url = \"http://localhost:5001/api/health-check\"
		http_request.request(url)

func _on_request_completed(result: int, response_code: int, headers: Array, body: PackedByteArray) -> void:
	if result == OK and response_code == 200:
		var raw_text = body.get_string_from_utf8()
		var data = JSON.parse_string(raw_text)
		
		if data.has(\"pump_control\"):
			var pump_on = data[\"pump_control\"]
			# Pass this to middle_level
			middle_level_script.set_pump_state(pump_on)
			print(\"Pump Control from PLC:\", pump_on)

		if data.has(\"valve_control\"):
			var valve_on = data[\"valve_control\"]
			# Pass this to middle_level
			middle_level_script.set_valve_state(valve_on)
			print(\"Valve Control from PLC:\", valve_on)
	else:
		print(\"HTTP error or no response. Code:\", response_code, \"Result:\", result)
"

